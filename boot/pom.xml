<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>multiai</groupId>
        <artifactId>multi-ai-provider</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>boot</artifactId>
    <name>boot</name>
    <packaging>jar</packaging>

    <dependencies>
        <!--
          The ai module contributes its beans through its own
          AutoConfiguration.imports entry — nothing here scans multiai.ai and
          nothing here needs to. Depending on the jar is the integration.
        -->
        <dependency>
            <groupId>multiai</groupId>
            <artifactId>ai</artifactId>
        </dependency>
        <!--
          Plain starter, no web stack: this application only makes outbound
          requests through the ai module — it exposes no HTTP surface of its own.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The parent declares this plugin skipped for every module; this is the one
              that turns it back on. `boot` is the only module that produces an
              executable artifact.

              The `repackage` execution is not optional boilerplate: this build imports
              the Spring Boot BOM rather than inheriting spring-boot-starter-parent, so
              nothing binds the goal by default. Without it `mvn package` produces a
              jar with no Main-Class and `java -jar` fails.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
